                  </HBox>
                  <Button fx:id="logInButton" mnemonicParsing="false" onMouseClicked="#switchToLogin" onMouseEntered="#hoverEnter" onMouseExited="#hoverExit" prefHeight="38.0" prefWidth="405.0" style="-fx-background-color: #C6FF3B; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand;" text="Inicia Sesion" textFill="#111111">
                     <font>
                        <Font name="SansSerif Bold" size="16.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </children>
      </Pane>
