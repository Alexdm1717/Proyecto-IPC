<!-- StackPane raiz para que al maximizar el contenido se quede centrado en vez de irse a la izquierda -->

<StackPane style="-fx-background-color: #F7F8F5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mapademo.singin.SinginPageController">
