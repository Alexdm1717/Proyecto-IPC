                        </Label>
                        <TextField fx:id="nameField" opacity="0.85" prefHeight="32.0" prefWidth="372.0" promptText="6-15 caracteres" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-background-color: #ffffff;" styleClass="input_text">
